# ==============================
# Fitness Arena — Environment Variables
# ==============================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Gym Info ----------
GYM_NAME="Fitness Arena"
GYM_EMAIL=info@fitnessarena.com
GYM_PHONE=+919090639005

# ---------- Email Notifications ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=info@fitnessarena.com

# ---------- Database ----------
# Local MongoDB
DB_URI=mongodb://127.0.0.1:27017/fitnessarena

# Or MongoDB Atlas (replace <username>, <password>, <cluster>)
# DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fitnessarena?retryWrites=true&w=majority

# ---------- Payment Gateway ----------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
