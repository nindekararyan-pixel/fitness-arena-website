# ==============================
# Fitness Arena — Environment Variables
# ==============================

# ---------- Server ----------
PORT=3000
NODE_ENV=development

# ---------- Gym Info ----------
GYM_NAME="Fitness Arena"
GYM_EMAIL=info@fitnessarena.com
GYM_PHONE=+919090639005

# ---------- Email Notifications ----------
# Fill these when you add nodemailer or another email service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=info@fitnessarena.com

# ---------- Database ----------
# Currently using data/*.json — replace with MongoDB/Postgres later.
DATABASE_URL=

# ---------- Payment Gateway ----------
# Razorpay (INR) or Stripe/PayPal for global payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
