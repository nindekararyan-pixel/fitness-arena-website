# ==============================
# Fitness Arena — Environment Variables
# ==============================

# ---------- Server ----------
PORT=3000
NODE_ENV=development

# ---------- Database (MongoDB) ----------
# Local:  mongodb://localhost:27017/fitness-arena
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitness-arena?retryWrites=true&w=majority
DB_URI=mongodb://localhost:27017/fitness-arena

# ---------- Auth (JWT) ----------
# Used to sign/verify tokens issued by POST /api/users/register and /login.
# Generate your own secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Gym Info ----------
GYM_NAME="Fitness Arena"
GYM_EMAIL=info@fitnessarena.com
GYM_PHONE=+919090639005

# ---------- Email Notifications ----------
# Fill these when you add nodemailer or another email service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=info@fitnessarena.com

# ---------- Payment Gateway (Razorpay) ----------
# Get these from your Razorpay dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
